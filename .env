# Application URLs and browser access
APPLICATION_URL=http://localhost:8080
METAMODEL_URL=${APPLICATION_URL}
API_GATEWAY_URL=${APPLICATION_URL}
FRONTEND_PORT=8080
SESSION_TIMEOUT=30d
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_PATTERNS=
LANGUAGES=en,fr,ru

# Application database
DATABASE_USERNAME=architeezy
DATABASE_PASSWORD=architeezy
DATABASE_PORT=5441

# Keycloak server and database
KEYCLOAK_URL=http://localhost:8181
KEYCLOAK_PORT=8181
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DATABASE_USERNAME=keycloak
KEYCLOAK_DATABASE_PASSWORD=keycloak
KEYCLOAK_DATABASE_PORT=5444

# Application authentication (OAuth 2.0)
OAUTH2_ACCOUNT_URL=${KEYCLOAK_URL}/realms/architeezy/account/
OAUTH2_API_CLIENT_ID=architeezy-api
OAUTH2_AUTHORIZATION_URL=${KEYCLOAK_URL}/realms/architeezy/protocol/openid-connect/auth
OAUTH2_CLIENT_ID=architeezy
OAUTH2_CLIENT_SECRET=A7KYjV1rQg6mC3b78QkogEU7KwRBvJJ6
OAUTH2_ISSUER_URL=${KEYCLOAK_URL}/realms/architeezy
OAUTH2_JWK_SET_URL=http://keycloak:8080/realms/architeezy/protocol/openid-connect/certs
OAUTH2_TOKEN_URL=http://keycloak:8080/realms/architeezy/protocol/openid-connect/token
OAUTH2_USER_INFO_URL=http://keycloak:8080/realms/architeezy/protocol/openid-connect/userinfo

# Redis
REDIS_PASSWORD=redis
REDIS_PORT=6382

# Mail (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_PROTOCOL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL_ENABLED=
SMTP_STARTTLS_ENABLED=
SMTP_MAIL_FROM=
SMTP_MAIL_TO=

# About, documentation and applications
ABOUT_URL=
DOCUMENTATION_URL=
APPLICATIONS_URL=

# JupyterHub
JUPYTERHUB_URL=http://localhost:8000

# Application-to-agent connection (ACP) and tools (MCP)
# Durations use units such as s or m. Only one agent endpoint is active.
AI_ACP_ENDPOINT=ws://opencode:8090/acp
AI_ACP_AUTH_TOKEN=caa4946b8eb4222f195cee9efa93cb2f0d98ea5486286fc63558ea2e2891b202
AI_ACP_CONNECT_TIMEOUT=10s
AI_VALIDATION_OUTPUT_LIMIT=51200
AI_CHAT_TIMEOUT=15m
METAMODEL_MCP_URL=http://backend:8082/mcp

# Agent process capacity and private session retention
# These limits prune private agent files, not chat history in the application database.
AI_ACP_MAX_PROCESSES=8
AI_ACP_MAX_CONVERSATIONS=1000
AI_ACP_RETENTION_DAYS=30

# OpenCode
OPENCODE_LLM_TIMEOUT=900000
OPENCODE_CONTEXT_LIMIT=200000
OPENCODE_OUTPUT_LIMIT=16384

# LLM proxy
LLM_PROXY_KEY=sk-023c13384d04444ce086efc40cf0c60dfff6ea5522e484de2d7f4e68219c1918

# Leave URL/model empty to run without the assistant
